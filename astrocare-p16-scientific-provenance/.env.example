# ASTROCARE P16 - SCIENTIFIC PROVENANCE & CITATION INTELLIGENCE
# Optional Environment Variables

# Node Environment
NODE_ENV=development

# NASA Open Science Data Repository (OSDR) API Endpoint (Default: Public API)
VITE_NASA_OSDR_API_BASE=https://osdr.nasa.gov/bio/repo/data/studies

# NASA Technical Reports Server (NTRS) Base URL
VITE_NASA_NTRS_BASE=https://ntrs.nasa.gov/citations

# Gemini AI Synthesis Integration (Future P15 Cross-Module Link)
VITE_GEMINI_MODEL_VERSION=Gemini-1.5-Pro-Aerospace-BioMed
VITE_ENABLE_LOCAL_STORAGE_PERSISTENCE=true
