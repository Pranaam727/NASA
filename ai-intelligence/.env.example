# ================================================================
# AstroCare Gemini AI Intelligence Module Environment Configuration
# Module Identifier: ai-intelligence
# ================================================================

# Backend Proxy Server Port
PORT=3001

# Google Gemini API Key
# Keep this key strictly on the server-side. It is NEVER exposed to the frontend.
# Obtain key from: https://aistudio.google.com/app/apikey
# If left empty, the module automatically activates high-fidelity mock simulation mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash
