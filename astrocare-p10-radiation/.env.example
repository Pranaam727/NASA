# ==============================================================================
# ASTROCARE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project Configuration
# When left unset or with placeholder values, AstroCare automatically runs in
# DEMO MODE using high-fidelity in-memory virtual simulation.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mission Simulation Configuration
VITE_DEFAULT_MISSION_CODE=ARES-VI
VITE_MISSION_TARGET=MARS_JEZERO_BASE
VITE_SIMULATION_SPEED=1.0

# Optional Google Gemini API Key (Note: for production, Gemini is proxied via Supabase Edge Function)
VITE_GEMINI_API_KEY=
