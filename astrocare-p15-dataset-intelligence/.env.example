# AstroCare P15 - NASA Biomedical Dataset Intelligence
# Environment Configuration Template

# NASA Open Science Data Repository (OSDR) Upstream API
VITE_NASA_OSDR_API_URL=https://osdr.nasa.gov/osdr/data

# Dev Server Proxy Route (Handles Browser CORS)
VITE_PROXY_ENDPOINT=/api/osdr

# Data Provider Mode: LIVE_WITH_FALLBACK | LIVE_STRICT | OFFLINE_BENCHMARK
VITE_PROVIDER_MODE=LIVE_WITH_FALLBACK

# Cache Lifetime in Minutes
VITE_CACHE_TIMEOUT_MINUTES=60
