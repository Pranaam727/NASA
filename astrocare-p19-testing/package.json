{
  "name": "@astrocare/qa-framework",
  "version": "1.0.0",
  "description": "AstroCare Comprehensive Testing, Scientific Validation & Quality Assurance Framework",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:bio": "vitest run tests/unit/biomedical",
    "test:sci": "vitest run tests/unit/scientific",
    "test:ai": "vitest run tests/unit/ai",
    "test:nasa": "vitest run tests/unit/nasa",
    "test:security": "vitest run tests/unit/security",
    "test:perf": "vitest run tests/unit/performance",
    "test:a11y": "vitest run tests/unit/accessibility",
    "test:regression": "vitest run tests/unit/regression",
    "test:all": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "qa:cli": "node --loader ts-node/esm scripts/run-qa-suite.ts",
    "audit:security": "npm.cmd audit --audit-level=high"
  },
  "keywords": [
    "astrocare",
    "aerospace",
    "biomedical",
    "testing",
    "validation",
    "nasa",
    "quality-assurance"
  ],
  "author": "AstroCare Team",
  "license": "Apache-2.0",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.9.1",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
